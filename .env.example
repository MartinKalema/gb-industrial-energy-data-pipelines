# Cloudflare R2. Keep real values only in .env, which Git ignores.
R2_ACCOUNT_ID=
R2_RAW_BUCKET=gb-industrial-thermal-energy-raw-dev
R2_LAKEHOUSE_BUCKET=gb-industrial-thermal-energy-lakehouse-dev
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
CLOUDFLARE_API_TOKEN=
R2_CATALOG_URI=
R2_CATALOG_WAREHOUSE=
R2_CATALOG_TOKEN=
R2_PIPELINE_PREFIX=industrial-energy

# Elexon REST requires no key. IRIS requires a free account and queue.
ELEXON_API_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
ELEXON_IRIS_CLIENT_ID=
ELEXON_IRIS_CLIENT_SECRET=
ELEXON_IRIS_QUEUE_NAME=
ELEXON_IRIS_SERVICE_BUS_NAMESPACE=elexon-insights-iris

# Local service credentials. Generate real values in the ignored `.env`.
POSTGRES_USER=industrial_energy
POSTGRES_PASSWORD=
POSTGRES_DB=industrial_energy
# Airflow generates and persists a high-entropy local password on first start.
AIRFLOW_PORT=8081

# Historical delivery product. Demo identity mode is local-only and is not
# production authentication; the API still enforces each persona's row scope.
PRODUCT_API_PORT=8000
PRODUCT_WEB_PORT=3000
PRODUCT_DEMO_MODE=true
PRODUCT_DEFAULT_ACTOR=commercial-manager
PRODUCT_API_TIMEOUT_MS=90000
PRODUCT_MAX_QUERY_DAYS=31
PRODUCT_MAX_PAGE_SIZE=200
PRODUCT_TRINO_TIMEOUT_SECONDS=20

# Local service endpoints
TRINO_HOST=trino
TRINO_PORT=8080
TRINO_URL=http://trino:8080
TRINO_USER=airflow
TRINO_QUERY_TIMEOUT_SECONDS=300
ICEBERG_CATALOG=r2
ICEBERG_VALIDATED_SCHEMA=industrial_energy_validated
TRINO_INSERT_BATCH_SIZE=100
PIPELINE_MAX_BATCH_DAYS=31
REDPANDA_BROKERS=redpanda:9092
