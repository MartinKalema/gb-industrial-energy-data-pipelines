{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.schema.json",
  "title": "Industrial energy source-contract common definitions",
  "description": "Reusable scalar definitions for Phase 2 source records. This file is referenced by the record schemas and is not itself a source-record contract.",
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "short_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "reason_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "semantic_version": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
    },
    "positive_revision": {
      "type": "integer",
      "minimum": 1
    },
    "utc_timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?Z$"
    },
    "utc_half_hour_boundary": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):(?:00|30):00Z$"
    },
    "iso_date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "decimal_20_6_nonnegative": {
      "type": "string",
      "description": "Canonical non-negative decimal(20,6): no sign, no leading zeroes, exactly six fractional digits.",
      "pattern": "^(?:0|[1-9][0-9]{0,13})\\.[0-9]{6}$"
    },
    "decimal_20_6_positive": {
      "type": "string",
      "description": "Canonical positive decimal(20,6).",
      "pattern": "^(?!0\\.000000$)(?:0|[1-9][0-9]{0,13})\\.[0-9]{6}$"
    },
    "decimal_20_6_signed": {
      "type": "string",
      "description": "Canonical signed decimal(20,6); negative zero is not canonical.",
      "pattern": "^-?(?:0|[1-9][0-9]{0,13})\\.[0-9]{6}$",
      "not": {
        "const": "-0.000000"
      }
    },
    "decimal_18_6_nonnegative": {
      "type": "string",
      "description": "Canonical non-negative decimal(18,6): no sign, no leading zeroes, exactly six fractional digits.",
      "pattern": "^(?:0|[1-9][0-9]{0,11})\\.[0-9]{6}$"
    },
    "approval_state": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "withdrawn"
      ]
    },
    "thermal_or_mass_unit": {
      "type": "string",
      "enum": [
        "MWh_th",
        "kWh_th",
        "GJ_th",
        "t"
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "r2_object_uri": {
      "type": "string",
      "minLength": 8,
      "maxLength": 2048,
      "pattern": "^(?:s3|r2)://[^/]+/.+$"
    }
  }
}
