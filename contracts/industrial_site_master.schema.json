{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "industrial_site_master.schema.json",
  "title": "Effective industrial-site-master version revision",
  "description": "PSC-006: one published revision of one effective descriptive version of one synthetic GB industrial site.",
  "$comment": "The validation layer enforces effective-period ordering, non-overlap, immutable physical identity, and referenced-site existence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_schema_id",
    "source_schema_version",
    "source_system_id",
    "site_natural_id",
    "site_version_id",
    "site_name",
    "locality",
    "postal_area",
    "country_code",
    "region_code",
    "iana_timezone",
    "operational_status",
    "effective_from_utc",
    "effective_to_utc",
    "source_revision",
    "revision_type",
    "version_record_status",
    "published_at_utc",
    "approval_state",
    "synthetic_data"
  ],
  "properties": {
    "source_schema_id": {
      "const": "industrial_site_master"
    },
    "source_schema_version": {
      "const": "1.0.0"
    },
    "source_system_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "site_natural_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "site_version_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "site_name": {
      "$ref": "common.schema.json#/$defs/short_text"
    },
    "locality": {
      "$ref": "common.schema.json#/$defs/short_text"
    },
    "postal_area": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16,
      "pattern": "^[A-Z0-9 ]+$"
    },
    "country_code": {
      "const": "GB"
    },
    "region_code": {
      "type": "string",
      "enum": [
        "GB-ENG",
        "GB-NIR",
        "GB-SCT",
        "GB-WLS"
      ]
    },
    "iana_timezone": {
      "const": "Europe/London"
    },
    "operational_status": {
      "type": "string",
      "enum": [
        "planned",
        "operational",
        "inactive",
        "decommissioned"
      ]
    },
    "latitude": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "longitude": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
    },
    "effective_from_utc": {
      "$ref": "common.schema.json#/$defs/utc_timestamp"
    },
    "effective_to_utc": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/utc_timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_revision": {
      "$ref": "common.schema.json#/$defs/positive_revision"
    },
    "revision_type": {
      "type": "string",
      "enum": [
        "original",
        "business_change",
        "correction",
        "deactivation",
        "cancellation"
      ]
    },
    "version_record_status": {
      "type": "string",
      "enum": [
        "active",
        "cancelled"
      ]
    },
    "published_at_utc": {
      "$ref": "common.schema.json#/$defs/utc_timestamp"
    },
    "approval_state": {
      "$ref": "common.schema.json#/$defs/approval_state"
    },
    "approved_at_utc": {
      "$ref": "common.schema.json#/$defs/utc_timestamp"
    },
    "approved_by": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "supersedes_source_revision": {
      "$ref": "common.schema.json#/$defs/positive_revision"
    },
    "corrected_at_utc": {
      "$ref": "common.schema.json#/$defs/utc_timestamp"
    },
    "correction_reason_code": {
      "type": "string",
      "enum": [
        "source_error",
        "descriptive_data_correction",
        "location_data_correction",
        "version_cancelled"
      ]
    },
    "correction_note": {
      "$ref": "common.schema.json#/$defs/reason_text"
    },
    "synthetic_data": {
      "const": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "approval_state": {
            "const": "approved"
          }
        },
        "required": [
          "approval_state"
        ]
      },
      "then": {
        "required": [
          "approved_at_utc",
          "approved_by"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "revision_type": {
            "enum": [
              "correction",
              "cancellation"
            ]
          }
        },
        "required": [
          "revision_type"
        ]
      },
      "then": {
        "required": [
          "supersedes_source_revision",
          "corrected_at_utc",
          "correction_reason_code",
          "approved_at_utc",
          "approved_by"
        ],
        "properties": {
          "approval_state": {
            "const": "approved"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "revision_type": {
            "const": "deactivation"
          }
        },
        "required": [
          "revision_type"
        ]
      },
      "then": {
        "properties": {
          "operational_status": {
            "enum": [
              "inactive",
              "decommissioned"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "revision_type": {
            "const": "cancellation"
          }
        },
        "required": [
          "revision_type"
        ]
      },
      "then": {
        "properties": {
          "version_record_status": {
            "const": "cancelled"
          }
        }
      },
      "else": {
        "properties": {
          "version_record_status": {
            "const": "active"
          }
        }
      }
    }
  ]
}
